# ============================================================
# CodeSentry - AI Coding Agent
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- Model Provider ---
# Options: openai | anthropic | hermes
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4o
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=sk-your-api-key-here
# For Anthropic:
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-5-20251001
# MODEL_BASE_URL=https://api.anthropic.com
# MODEL_API_KEY=sk-ant-your-key-here
# For Hermes (local / OpenAI-compatible):
# MODEL_PROVIDER=hermes
# MODEL_NAME=hermes-3
# MODEL_BASE_URL=http://localhost:8080/v1
# MODEL_API_KEY=not-needed

# --- Agent Configuration ---
MAX_ITERATIONS=15
CONTEXT_COMPRESSION_THRESHOLD_TOKENS=8000
AGENT_TEMPERATURE=0.1

# --- Workspace Security ---
# All file operations are restricted to this directory
WORKSPACE_ROOT=/workspace

# --- Risk Approval ---
# Auto-approve tools at or below this risk level (low|medium|high|none)
AUTO_APPROVE_RISK_LEVEL=low

# --- Database ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=codesentry
POSTGRES_PASSWORD=codesentry_dev
POSTGRES_DB=codesentry

# --- ChromaDB (Vector Store for Long-term Memory) ---
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- Redis (Prompt Cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Prompt Cache ---
PROMPT_CACHE_ENABLED=true
PROMPT_CACHE_TTL_SECONDS=3600

# --- Audit ---
AUDIT_LOG_LEVEL=INFO

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
